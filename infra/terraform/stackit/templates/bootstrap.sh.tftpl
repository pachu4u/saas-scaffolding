#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/saas-platform-bootstrap.log) 2>&1

REPO_DIR=/opt/saas-platform/repo
RENDER_DIR=/opt/saas-platform/render

echo "→ Cloning ${git_repo_url} @ ${git_ref}"
export GIT_SSH_COMMAND="ssh -i /opt/saas-platform/deploy_key -o StrictHostKeyChecking=accept-new"
if [[ ! -d "$REPO_DIR/.git" ]]; then
  git clone --branch "${git_ref}" --depth 1 "${git_repo_url}" "$REPO_DIR"
fi
cd "$REPO_DIR"

echo "→ Dropping techhanker.com dev-tenant Traefik artifacts (regenerated per-tenant on this domain once real tenants provision -- see docs/infra/tenant-provisioner.md)"
rm -f infra/compose/traefik/dynamic/tenant-acme.yml \
      infra/compose/traefik/dynamic/tenant-demo.yml \
      infra/compose/traefik/dynamic/tenant-globex.yml

echo "→ Overlaying rendered, domain-specific config"
cp "$RENDER_DIR/env" "$REPO_DIR/.env"
cp "$RENDER_DIR/docker-compose.stackit.yml" "$REPO_DIR/infra/compose/docker-compose.stackit.yml"
cp "$RENDER_DIR/traefik.yaml" "$REPO_DIR/infra/compose/traefik/traefik.yml"
cp "$RENDER_DIR/dynamic-web.yaml" "$REPO_DIR/infra/compose/traefik/dynamic/web.yml"
cp "$RENDER_DIR/dynamic-keycloak.yaml" "$REPO_DIR/infra/compose/traefik/dynamic/keycloak.yml"
cp "$RENDER_DIR/dynamic-riogentix-tenants.yaml" "$REPO_DIR/infra/compose/traefik/dynamic/riogentix-tenants.yml"
cp "$RENDER_DIR/dynamic-tenant-app-admin-subdomains.yaml" "$REPO_DIR/infra/compose/traefik/dynamic/tenant-app-admin-subdomains.yml"
cp "$RENDER_DIR/dynamic-tls.yaml" "$REPO_DIR/infra/compose/traefik/dynamic/tls.yml"
mkdir -p "$REPO_DIR/infra/compose/caddy"
cp "$RENDER_DIR/Caddyfile" "$REPO_DIR/infra/compose/caddy/Caddyfile"
# Overwrites the git-tracked default (hardcoded to techhanker.com redirect
# URIs/secrets) before Keycloak's first boot -- see locals.tf
# realm_export_content for why.
cp "$RENDER_DIR/realm-export.json" "$REPO_DIR/infra/keycloak/realm-export.json"
mkdir -p "$REPO_DIR/infra/k8s/tenant-provisioner"
cp "$RENDER_DIR/tenant-provisioner-secret.env" "$REPO_DIR/infra/k8s/tenant-provisioner/secret.env"
mkdir -p "$REPO_DIR/infra/compose/traefik/acme" "$REPO_DIR/infra/compose/traefik/certs"
# infra/docker/web.Dockerfile does a literal-path COPY of this file to trust
# it as a Node.js CA (mkcert dev cert, see scripts/mkcert-setup.sh) -- it's
# gitignored and only ever populated on a dev machine that ran that script,
# so a fresh clone's docker build 404s without it. This deployment trusts
# real ACME certs instead and never runs mkcert-setup.sh, so an empty file
# is enough to satisfy the COPY; update-ca-certificates treats it as a no-op.
touch "$REPO_DIR/infra/compose/traefik/certs/mkcert-rootCA.pem"

echo "→ Installing Node 20 + pnpm (host-side Prisma migrate + keycloak sync -- same tools scripts/dev.sh uses locally)"
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs
corepack enable
corepack prepare pnpm@9.6.0 --activate
pnpm install --frozen-lockfile

echo "→ Creating shared Docker network"
docker network create platform 2>/dev/null || true

echo "→ Installing buildx (Ubuntu's docker.io package, unlike Docker CE, doesn't bundle it -- every Dockerfile here uses RUN --mount=type=cache, a BuildKit-only feature, so plain docker build/compose build 400s without it)"
if ! docker buildx version &>/dev/null; then
  mkdir -p ~/.docker/cli-plugins
  curl -sSL -o ~/.docker/cli-plugins/docker-buildx \
    https://github.com/docker/buildx/releases/download/v0.19.3/buildx-v0.19.3.linux-amd64
  chmod +x ~/.docker/cli-plugins/docker-buildx
fi

echo "→ Building and starting the platform stack"
set -a
# shellcheck disable=SC1091
source .env
set +a
# app-db and redis are STACKIT-managed (see infra/terraform/stackit/database.tf)
# -- scaled to 0 here since docker-compose.stackit.yml can't remove a
# service the base docker-compose.yml defines. See that override file's
# comment for why `deploy.replicas: 0` doesn't work for this instead.
#
# No --wait: docker-compose.tools.yml's stripe-cli container has no way to
# succeed without a real Stripe key (its placeholder default isn't a valid
# key, so it always exits 1) -- `up --wait` treats any non-running container
# as a failure and aborts the whole script under set -e, killing every step
# after it (migrations, keycloak sync, k3s, tenant-provisioner). Poll the
# containers that actually matter instead.
DOCKER_BUILDKIT=1 docker compose \
  -f infra/compose/docker-compose.yml \
  -f infra/compose/docker-compose.observability.yml \
  -f infra/compose/docker-compose.tools.yml \
  -f infra/compose/docker-compose.stackit.yml \
  up -d --build --scale app-db=0 --scale redis=0

echo "→ Waiting for web to be healthy"
until [ "$(docker inspect -f '{{.State.Health.Status}}' web 2>/dev/null)" = "healthy" ]; do
  sleep 5
done

echo "→ Waiting for the managed Postgres Flex instance to accept connections"
DB_HOSTPORT=$(echo "$DATABASE_URL" | sed -E 's#^[a-zA-Z]+://[^@]+@([^/?]+).*#\1#')
DB_HOST=$${DB_HOSTPORT%%:*}
DB_PORT=$${DB_HOSTPORT##*:}
until (exec 3<>"/dev/tcp/$DB_HOST/$DB_PORT") 2>/dev/null; do
  sleep 2
done

echo "→ Running DB migrations (demo fixtures skipped -- this is a real environment, not the acme/globex/notes sample data -- but essential system data still needs seeding, see below)"
# Not a plain `pnpm --filter @platform/db db:migrate`: STACKIT-managed
# Postgres Flex doesn't grant the app's DB user CREATEROLE (nor expose any
# superuser credential), and the earliest migrations CREATE ROLE
# app/migrator/platform_admin -- see scripts/migrate-stackit.sh for the full
# story and why 0001_init/0002_rls_grants are deliberately left unedited.
command -v psql &>/dev/null || apt-get install -y -qq postgresql-client
bash infra/terraform/stackit/scripts/migrate-stackit.sh

echo "→ Seeding essential system data (roles, permissions, plans)"
# packages/db/src/seed.ts (full db:seed) bundles this together with demo
# fixtures (acme/globex tenants) that don't belong on a real deployment --
# db:seed:system is just the essential subset. Skipping this entirely (as
# earlier versions of this script did) leaves the roles table empty, which
# silently no-ops role assignment on every tenant invite with no error --
# found the hard way testing a real tenant, 2026-08-22.
pnpm --filter @platform/db db:seed:system

echo "→ Pushing realm client config into Keycloak"
node infra/keycloak/sync-realm.mjs

echo "→ Installing k3s (tenant-provisioner cluster -- shares this host with docker-compose, see docs/infra/tenant-provisioner.md)"
# --disable=traefik: k3s ships its own Traefik ingress controller enabled by
# default, whose ServiceLB component binds host ports 80/443 directly via
# iptables rules that take priority over Docker's own port publishing. Left
# enabled, it silently intercepts ALL traffic to those ports -- including
# from the VM's own loopback -- ahead of the docker-compose Traefik/Caddy
# stack being deployed above, with no error or obvious symptom beyond every
# TLS handshake mysteriously returning a default self-signed cert. This isn't
# used for anything here (the tenant-provisioner's own k8s ingress is a
# separate NodePort service, not this default LoadBalancer one) -- confirmed
# and root-caused 2026-08-22 after an extensive, otherwise-inconclusive TLS
# investigation (see dynamic-tls.yaml.tftpl).
curl -sfL https://get.k3s.io | sh -s - --disable=traefik
until k3s kubectl get nodes &>/dev/null; do sleep 2; done
mkdir -p ~/.kube
cp /etc/rancher/k3s/k3s.yaml ~/.kube/config

echo "→ Patching tenant-provisioner hostPath (deployment.yaml hardcodes the dev checkout path -- this VM's checkout lives at $REPO_DIR instead)"
sed -i "s#/root/.openclaw/workspace/saas-scaffolding/infra/compose/traefik/dynamic#$REPO_DIR/infra/compose/traefik/dynamic#" \
  "$REPO_DIR/infra/k8s/tenant-provisioner/deployment.yaml"

echo "→ Deploying the saas-workers tenant-provisioner"
cd "$REPO_DIR/infra/k8s/tenant-provisioner"
./deploy.sh

echo "✓ Bootstrap complete -- see /var/log/saas-platform-bootstrap.log for the full trace"
