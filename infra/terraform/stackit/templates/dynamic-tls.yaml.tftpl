# No static certificates here (unlike the techhanker.com host's tls.yml,
# which references mkcert/manually-issued cert files) -- every host on this
# deployment gets a cert on-demand from whichever resolver is selected (see
# traefik.yaml.tftpl and locals.tf acme_cert_resolver, referenced by the
# per-router certResolver: ${acme_cert_resolver} entries in the other
# dynamic-*.yaml files).
tls:
  options:
    default:
      minVersion: VersionTLS12
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
