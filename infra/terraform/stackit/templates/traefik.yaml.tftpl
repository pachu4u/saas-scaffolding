global:
  checkNewVersion: false
  sendAnonymousUsage: false

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    defaultMode: keep
    headers:
      defaultMode: drop
      names:
        X-Request-Id: keep

api:
  dashboard: true
  insecure: false

# TLS termination + automatic HTTPS moved to Caddy (infra/compose/caddy/,
# see Caddyfile.tftpl) -- Traefik's own ACME-obtained certs were never
# actually served on the wire despite being genuinely, successfully issued
# and added to its cert store (confirmed via internal debug logs), a
# reproducible defect isolated across per-host and wildcard certs,
# freshly-issued and store-loaded certs, static (non-ACME) file-provider
# certs, and Traefik v3.1.7 and v3.5.6 -- 2026-08-22. (Root-caused
# separately: k3s's own default Traefik ingress was also intercepting
# ports 80/443 via ServiceLB the whole time -- see bootstrap.sh.tftpl's
# `--disable=traefik` k3s install flag -- but Caddy replacing Traefik's
# ACME/TLS layer here stands on its own regardless.)
#
# Traefik now only does plain-HTTP routing on the "web" entrypoint, reached
# over the internal docker network (no host port publish -- see
# docker-compose.stackit.yml.tftpl's traefik.ports: !override []).
entryPoints:
  web:
    address: ':80'

providers:
  # File provider only -- see infra/compose/traefik/traefik.yml on the
  # techhanker.com host for why the Docker provider isn't used.
  file:
    directory: /etc/traefik/dynamic
    watch: true
