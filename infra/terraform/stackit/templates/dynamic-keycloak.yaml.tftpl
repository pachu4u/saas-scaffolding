http:
  routers:
    keycloak:
      rule: 'Host(`auth.${domain_name}`)'
      entryPoints:
        - websecure
      tls:
        certResolver: ${acme_cert_resolver}
      service: keycloak
      priority: 100

  services:
    keycloak:
      loadBalancer:
        servers:
          - url: 'http://keycloak:8080'
