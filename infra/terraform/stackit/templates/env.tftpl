# Rendered by Terraform (templates/env.tftpl) -- written to the repo root
# as .env on first boot. Loaded two ways, matching scripts/dev.sh: (1) via
# `env_file: ../../.env` for container runtime vars, and (2) exported into
# the shell before `docker compose up` so Compose's own variable
# interpolation picks it up too (e.g. keycloak's KEYCLOAK_ADMIN_PASSWORD
# default -- app-db/redis's own compose-side interpolation is moot now that
# both are scaled to 0, see docker-compose.stackit.yml.tftpl).
# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://saas.${domain_name}
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# STACKIT-managed Postgres Flex -- same URL works for host-side tools (Prisma
# CLI migrate) and containers, since it's reachable over the network rather
# than confined to the platform Docker network like the old app-db container.
DATABASE_URL=${database_url}
DATABASE_URL_MIGRATOR=${database_url}

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER=https://auth.${domain_name}/realms/saas-platform
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_CLIENT_SECRET=${keycloak_client_secret}

# ─── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET=${auth_secret}
AUTH_URL=https://saas.${domain_name}
# Fixed oauth2-proxy callback host (see docker-compose.stackit.yml override) --
# explicit here even though tenant-authz can derive it, so the two can't drift.
OAUTH_PROXY_HOST=oauthproxy.${domain_name}

# ─── Redis ───────────────────────────────────────────────────────────────────
# STACKIT-managed Redis.
REDIS_URL=${redis_url}
REDIS_PASSWORD=${redis_password}

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=${stripe_secret_key}
STRIPE_WEBHOOK_SECRET=${stripe_webhook_secret}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${stripe_publishable_key}

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=${resend_api_key}
EMAIL_FROM=${email_from}

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=saas-platform-web
# Grafana/Traefik dashboards aren't exposed publicly on this deployment (see
# docker-compose.stackit.yml.tftpl) -- leave unset so the admin Settings
# page hides those link cards instead of pointing at a dead URL.

# ─── Internal ────────────────────────────────────────────────────────────────
PLATFORM_INTERNAL_SECRET=${platform_internal_secret}

# ─── Riogentix integration ───────────────────────────────────────────────────
# TENANT_STACK_DRIVER=kubernetes (below) means each tenant's Riogentix URL is
# resolved from its own k8s Secret -- RIOGENTIX_INTERNAL_URL intentionally
# left unset, see docs/infra/tenant-provisioner.md.
RIOGENTIX_SAAS_INTERNAL_SECRET=${riogentix_saas_internal_secret}
RIOGENTIX_INTERNAL_SECRET=${riogentix_internal_secret}
RIOGENTIX_PUBLIC_URL=https://riogentix.${domain_name}

# ─── Keycloak admin ────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=${keycloak_admin_username}
KEYCLOAK_ADMIN_PASSWORD=${keycloak_admin_password}
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=saas-platform
KEYCLOAK_ADMIN_USERNAME=${keycloak_admin_username}

# ─── HashiCorp Vault ─────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_MOUNT_PATH=secret

# ─── Per-tenant stack provisioning (docker-compose `workers` fleet) ──────────
# The docker-compose `workers` service must NOT run the kubernetes driver
# (see infra/k8s/tenant-provisioner/secret.env.tftpl for the deployment that
# actually does) -- it has no ServiceAccount/kubeconfig to act on the
# cluster. Left at the schema default ('shared') here; WORKER_ENABLE_APP_SYNC
# below keeps app-sync off this fleet for the same in-cluster-only reason.
WORKER_ENABLE_APP_SYNC=false

# ─── DNS-01 (Traefik lego provider + tenant-provisioner) ────────────────────
# Read by both: Traefik's lego library reads these var names directly from
# the container env (env_file: ../../.env, see infra/compose/docker-compose.yml)
# for the "cloudflare"/"ionos" certResolver's dnsChallenge (see
# templates/traefik.yaml.tftpl); apps/workers/src/provisioning/tenant-dns.ts
# reads the same values via @platform/config for per-tenant wildcard records.
# Mutually exclusive -- only one is normally non-empty (see locals.tf
# acme_cert_resolver); blank is fine, both no-op without their token.
CF_DNS_API_TOKEN=${cloudflare_dns_api_token}
IONOS_API_KEY=${ionos_api_key}

# ─── Git ─────────────────────────────────────────────────────────────────────
GIT_SHA=${git_ref}
%{ for key, value in additional_secrets ~}
${key}=${value}
%{ endfor ~}
