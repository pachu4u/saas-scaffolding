# Rendered by Terraform (templates/tenant-provisioner-secret.env.tftpl) --
# copied to infra/k8s/tenant-provisioner/secret.env by bootstrap.sh, then
# applied as the saas-workers-env Secret by deploy.sh. This is the ONLY
# process configured with TENANT_STACK_DRIVER=kubernetes -- see
# docs/infra/tenant-provisioner.md for why the docker-compose `workers`
# fleet must never be pointed at this driver.
NODE_ENV=production
PORT=3000

# app-db and redis are published on the host (ports 5434/6379) specifically
# so this in-cluster pod -- a separate k3s network namespace with no route
# to the "platform" Docker network -- can reach them via the host's docker0
# gateway address instead. Same convention the techhanker.com host uses.
DATABASE_URL=postgresql://postgres:${app_db_password}@172.18.0.1:5434/saas_platform
DATABASE_URL_MIGRATOR=postgresql://postgres:${app_db_password}@172.18.0.1:5434/saas_platform
REDIS_URL=redis://:${redis_password}@172.18.0.1:6379

AUTH_SECRET=${auth_secret}
AUTH_URL=https://saas.${domain_name}

KEYCLOAK_ADMIN=${keycloak_admin_username}
KEYCLOAK_ADMIN_USERNAME=${keycloak_admin_username}
KEYCLOAK_ADMIN_PASSWORD=${keycloak_admin_password}
KEYCLOAK_CLIENT_ID=web
KEYCLOAK_CLIENT_SECRET=${keycloak_client_secret}
KEYCLOAK_REALM=saas-platform
KEYCLOAK_ISSUER=https://auth.${domain_name}/realms/saas-platform
KEYCLOAK_INTERNAL_ISSUER=http://172.18.0.1:8081/realms/saas-platform
KEYCLOAK_INTERNAL_URL=http://172.18.0.1:8081

TENANT_STACK_DRIVER=kubernetes
TENANT_BASE_DOMAIN=${domain_name}
TENANT_INGRESS_CLASS=nginx
TENANT_PG_ADMIN_URL=postgresql://postgres:${app_db_password}@172.18.0.1:5434/saas_platform
TENANT_POD_CPU_LIMIT=1
TENANT_POD_MEMORY_LIMIT=1Gi

# Cloudflare DNS edit-scope token for ${domain_name}'s zone + the origin IP
# that per-tenant grey-cloud wildcard records (*.{slug}.${domain_name}) point
# at -- the STACKIT load balancer's public IP, i.e. the same IP the domain's
# own apex/wildcard A records point at.
CF_DNS_API_TOKEN=${cloudflare_dns_api_token}
TENANT_APP_SUBDOMAIN_IP=${load_balancer_ip}
TRAEFIK_DYNAMIC_DIR=/etc/traefik-dynamic

RIOGENTIX_IMAGE=${riogentix_image}
RIOGENTIX_CONTAINER_PORT=8000
RIOGENTIX_INTERNAL_URL=
RIOGENTIX_PUBLIC_URL=https://riogentix.${domain_name}
RIOGENTIX_INTERNAL_SECRET=${riogentix_internal_secret}
RIOGENTIX_SAAS_INTERNAL_SECRET=${riogentix_saas_internal_secret}
PLATFORM_INTERNAL_SECRET=${platform_internal_secret}

NEXT_PUBLIC_APP_URL=https://saas.${domain_name}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${stripe_publishable_key}
STRIPE_SECRET_KEY=${stripe_secret_key}
STRIPE_WEBHOOK_SECRET=${stripe_webhook_secret}

EMAIL_FROM=${email_from}
RESEND_API_KEY=${resend_api_key}

OTEL_SERVICE_NAME=saas-workers
OTEL_EXPORTER_OTLP_ENDPOINT=http://172.18.0.1:4318

VAULT_ADDR=http://172.18.0.1:8200
VAULT_MOUNT_PATH=secret
VAULT_TOKEN=root
