# Copy to terraform.tfvars and fill in. Do not commit terraform.tfvars --
# it will contain (directly or via state) sensitive values.

organization_id                  = "00000000-0000-0000-0000-000000000000"
project_id                       = "00000000-0000-0000-0000-000000000000"
stackit_region                   = "eu01"
stackit_service_account_key_path = "./stackit-sa-key.json"

ssh_allowed_cidrs   = ["203.0.113.4/32"] # your IP, NOT 0.0.0.0/0
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

git_repo_url        = "git@github.com:pachu4u/saas-scaffolding.git"
git_ref             = "main"
git_deploy_key_path = "./stackit-deploy-key" # read-only GitHub deploy key, see README -- only needed if the repo is private; a public repo can use an https:// git_repo_url and this file's contents go unused

domain_name = "riogentix.com"
acme_email  = "platform@riogentix.com"
# TLS is Caddy's automatic HTTPS (ACME HTTP-01 per host) -- just needs
# A/CNAME records pointed at the load balancer, no DNS API token required.
# Set at most one of these two, matching domain_name's actual DNS host
# (check with `dig NS <domain_name>` -- Cloudflare nameservers vs IONOS
# ns*.ui-dns.*), to enable automatic per-tenant DNS record creation on
# provision. Both optional -- leave both unset and tenant DNS automation
# no-ops with a warning instead of failing (create records manually instead).
cloudflare_dns_api_token = "" # Zone:DNS:Edit scope token, from the Cloudflare dashboard
ionos_api_key            = "" # "publicPrefix.secret" format, from my.ionos.com (Web Hosting/Domains account) API Keys -- NOT cloud.ionos.com, a separate product with unrelated DNS zones

riogentix_image = "registry.onstackit.cloud/riogentix/riogentix-backend:latest" # verify this is the correct/current tag before first apply
# Only needed if riogentix_image is on a private registry (STACKIT's own
# Harbor instance is private by default) -- leave all three blank for a
# public image. A Harbor robot account (Administration > Robot Accounts,
# read-only, scoped to the one project) is a better fit than a personal
# login for this.
riogentix_image_registry      = "registry.onstackit.cloud"
riogentix_image_pull_username = ""
riogentix_image_pull_password = ""

# web_image/workers_image default to the saas-scaffolding repo's own CI
# output (.github/workflows/stackit-images.yml) -- override only if you're
# pushing to a different registry/project. Same three credentials above are
# reused for `docker login` on the VM itself (see bootstrap.sh.tftpl).
# web_image     = "registry.onstackit.cloud/saas-platform/web:latest"
# workers_image = "registry.onstackit.cloud/saas-platform/workers:latest"

# STACKIT-managed Redis plan -- no Terraform data source lists these, verify
# with `stackit redis plans` (STACKIT CLI) or the Portal before first apply.
redis_plan_name = "stackit-redis-1.2.10-single"

# Extra CIDRs (in addition to network_ipv4_prefix) allowed to reach the
# managed Postgres Flex/Redis instances -- likely needs the app VM's actual
# NAT egress IP after first apply. See README "known gaps".
managed_services_acl_cidrs = []

# Leave these empty to launch without them (Stripe/email features disabled
# until set) -- fill in for a real production cutover.
stripe_secret_key      = ""
stripe_webhook_secret  = ""
stripe_publishable_key = ""
resend_api_key         = ""
email_from             = ""

# SMTP takes priority over Resend when smtp_host is set. STACKIT MailOut
# (Portal > Messaging/MailOut) is a good fit -- purpose-built transactional
# relay with managed SPF/DKIM/DMARC, not a personal mailbox. Set up a
# Sending Domain there, add the DNS records it gives you, then create an
# Authorized Sender on that domain for the username/password/endpoint below.
smtp_host     = ""
smtp_port     = 587
smtp_username = ""
smtp_password = ""

additional_secrets = {
  # OPENAI_API_KEY = "sk-..."
}
